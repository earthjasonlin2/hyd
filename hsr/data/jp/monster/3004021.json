                    "SPHitBase": ""
                },
                {
                    "Id": 300402102,
                    "SkillName": "バナ育コマ割り",
                    "SkillDesc": "アクションバーに「学期末パーティー」が追加される。「学期末パーティー」が行動する時、フィールド上にいるすべての「バナ研」メンバーに付与されている行動制限系デバフおよび弱点撃破状態を解除し、「バナ研」全体を「講義チャンネル」状態にし、さらに「博士に捧げる：バナ育成果発表会」を発動する。",
                    "DamageType": "",
                    "SPHitBase": ""
                },
                {
                    "Id": 300402103,
                    "SkillName": "博士に捧げる：バナ育成果発表会",
                    "SkillDesc": "敵全体の攻撃力をアップし、味方全体のEPとSPを減らす。味方全体に量子属性ダメージと炎属性ダメージを与え、確率で味方全体に減速状態を付与する。さらに、高確率で味方全体を「燃焼」状態にする。",
                    "DamageType": "",
                    "SPHitBase": ""
                },
